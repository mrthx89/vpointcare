{"nodes": [{"id": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_wrong_pengguna_table_bug", "label": "Bug: Query ke Tabel 'Pengguna' yang Tidak Ada", "file_type": "rationale", "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Summary; Current State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookup memakai DB::table('Pengguna') padahal tabel pengguna WACS adalah MPengguna. Bug tidak menimbulkan error terlihat karena dijaga Schema::hasTable('Pengguna') yang selalu false, sehingga sistem diam-diam jatuh ke label fallback 'Sistem'. Pemeriksaan dihapus seluruhnya, bukan diperbaiki, agar cache lama bernilai false tidak lagi dibaca."}, {"id": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_resolves_catatan_internal_trait", "label": "Trait ResolvesCatatanInternal", "file_type": "rationale", "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trait dipilih karena kedua pemakainya (InboxWhatsapp dan ViewChatSession) adalah Filament Page dan repo sudah memakai pola ini pada App\\Filament\\Concerns\\HasMenuBreadcrumbs; memusatkan logika agar bug tidak tersalin lagi antar halaman."}, {"id": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_single_query_not_n_plus_1", "label": "Resolusi Nama Pembuat via Satu Query (Anti N+1)", "file_type": "rationale", "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 2; Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helper mengumpulkan DibuatOleh unik lalu satu query MPengguna whereIn('Id', ...) menggantikan satu query per baris catatan. Query sengaja tidak memfilter NonAktif agar nama pengguna nonaktif tetap tampil pada catatan historis."}, {"id": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_dual_key_compatibility", "label": "Kompatibilitas Dua Kunci Array (DibuatOlehNama & NamaPembuat)", "file_type": "rationale", "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 5; Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "InboxWhatsapp memakai kunci DibuatOlehNama sedangkan ViewChatSession memakai NamaPembuat; helper mengembalikan keduanya agar blade existing tidak perlu diubah dan tidak ada risiko regresi tampilan."}], "edges": [{"source": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_wrong_pengguna_table_bug", "target": "openspec_changes_fix_nama_pembuat_catatan_internal_specs_vpoint_care_spec_referensi_tabel_pengguna_yang_benar", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 4", "weight": 1.0}, {"source": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_resolves_catatan_internal_trait", "target": "openspec_changes_fix_nama_pembuat_catatan_internal_specs_vpoint_care_spec_atribusi_pembuat_catatan_internal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 1", "weight": 1.0}, {"source": "openspec_changes_fix_nama_pembuat_catatan_internal_proposal_single_query_not_n_plus_1", "target": "openspec_changes_fix_nama_pembuat_catatan_internal_specs_vpoint_care_spec_atribusi_pembuat_catatan_internal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/fix-nama-pembuat-catatan-internal/proposal.md", "source_location": "Proposed Changes 2; Scenario Beban query resolusi nama", "weight": 1.0}, {"sou