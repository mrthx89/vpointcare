{"nodes": [{"id": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_light_outline_theme", "label": "Light Outline Theme", "file_type": "rationale", "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Ringkasan; Keputusan Desain 1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kedalaman visual dibuat dari border, background solid, dan spacing \u2014 bukan bayangan \u2014 karena dashboard admin dengan banyak tabel/form/prompt butuh tampilan ringan dan keterbacaan tinggi. Radius tunggal untuk card/hero/panel, radius sedikit lebih kecil untuk input."}, {"id": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_no_shadow_no_gradient", "label": "Tanpa Shadow dan Gradient", "file_type": "rationale", "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Ringkasan 4; Temuan Awal; Acceptance Criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shadow dan gradient membuat tampilan terasa berat dan kurang konsisten dengan kebutuhan dashboard admin; status/provider diganti warna solid lembut dengan border aksen agar tetap menonjol."}, {"id": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_monospace_technical_textarea", "label": "Monospace untuk Textarea Teknis", "file_type": "rationale", "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Ringkasan 3; Keputusan Desain 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Textarea berisi prompt/template lebih mudah diaudit dengan monospace karena indentasi, placeholder, token, dan struktur teks menjadi presisi; monospace dibatasi ke area teknis agar label dan heading tidak terlihat kaku."}, {"id": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_compact_typography_scale", "label": "Skala Tipografi Compact Admin", "file_type": "rationale", "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Skala Tipografi Target", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hero dan card title dianggap terlalu besar sehingga mendominasi halaman; skala diturunkan ke ukuran admin dashboard compact agar hierarchy lebih rapi."}], "edges": [{"source": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_light_outline_theme", "target": "openspec_changes_audit_ai_agent_light_outline_ui_specs_vpoint_care_spec_global_filament_admin_light_outline_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Keputusan Desain 1-3", "weight": 1.0}, {"source": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_no_shadow_no_gradient", "target": "openspec_changes_audit_ai_agent_light_outline_ui_specs_vpoint_care_spec_global_filament_admin_light_outline_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Acceptance Criteria", "weight": 1.0}, {"source": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_monospace_technical_textarea", "target": "openspec_changes_audit_ai_agent_light_outline_ui_specs_vpoint_care_spec_global_technical_textarea_monospace", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/audit-ai-agent-light-outline-ui/proposal.md", "source_location": "Keputusan Desain 4", "weight": 1.0}, {"source": "openspec_changes_audit_ai_agent_light_outline_ui_proposal_compact_typography_scale", "target": "openspec_changes_audit_ai_agent_light_outline_ui_specs_vpoint_care_spec_global_filament_admin_typography_scale", "relation": "implements", "confidence": "EXTRACTED", "confidence_sco