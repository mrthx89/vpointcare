{"nodes": [{"id": "openspec_changes_align_seed_master_ticketing_proposal_single_source_of_truth_seed", "label": "DatabaseSeeder sebagai Sumber Tunggal Seed Master Ticketing", "file_type": "rationale", "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Summary; Proposed Changes 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dua sumber seed (INSERT di DATABASE_SCHEMA_WACS.sql dan DatabaseSeeder::seedTicketingMasters()) menghasilkan status ganda dan SLA saling menimpa; seeder dipilih sebagai sumber kebenaran karena idempotent (updateOrInsert) sehingga instalasi baru dan database existing konvergen."}, {"id": "openspec_changes_align_seed_master_ticketing_proposal_canonical_status_list", "label": "Daftar Kanonik MStatusTicket/MKategoriTicket/MPrioritasTicket", "file_type": "rationale", "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daftar dari DATABASE_SCHEMA_WACS.sql diadopsi karena memodelkan alur eskalasi CS \u2192 developer yang nyata dan sudah ada di setiap database terpasang, sehingga tidak memperkenalkan kode baru ke data production."}, {"id": "openspec_changes_align_seed_master_ticketing_proposal_sla_rendah_2880", "label": "Keputusan SLA RENDAH = 2880 Menit", "file_type": "rationale", "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 1 (Keputusan disetujui 2026-07-23)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2880 menit adalah nilai yang efektif berlaku pada seluruh database yang sudah pernah menjalankan db:seed, sehingga penyelarasan tidak mengubah nilai SLA berjalan mana pun; nilai 4320 dari file schema ditinggalkan."}, {"id": "openspec_changes_align_seed_master_ticketing_proposal_safe_deactivation_migration", "label": "Penonaktifan Aman Kode Master Non-Kanonik", "file_type": "rationale", "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 3; Rollback 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baris master tidak dihapus agar foreign key ticket tidak rusak; hanya kode tanpa referensi yang di-set NonAktif = 1, kode yang masih dipakai dibiarkan aktif dan dilaporkan agar pemetaan dilakukan secara sadar, bukan otomatis. down() hanya mengaktifkan kembali kode yang benar-benar dinonaktifkan olehnya."}, {"id": "openspec_changes_align_seed_master_ticketing_proposal_status_mapping_table", "label": "Tabel Pemetaan Status/Kategori Lama ke Kanonik", "file_type": "concept", "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_changes_align_seed_master_ticketing_proposal_single_source_of_truth_seed", "target": "openspec_changes_align_seed_master_ticketing_specs_vpoint_care_spec_sumber_tunggal_master_ticketing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 2", "weight": 1.0}, {"source": "openspec_changes_align_seed_master_ticketing_proposal_canonical_status_list", "target": "openspec_changes_align_seed_master_ticketing_specs_vpoint_care_spec_sumber_tunggal_master_ticketing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/align-seed-master-ticketing/proposal.md", "source_location": "Proposed Changes 1", "weight": 1.0}, {"source": "openspec_changes_align_seed_master_ticketing_proposal_sla_rendah_2880", "target": "openspec_changes_align_seed_master_ticketing_specs_vpoint_care_spec_nilai_sla_pr