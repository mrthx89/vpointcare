{"nodes": [{"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_async_webhook_processing", "label": "Asynchronous Webhook Processing", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 1; Goals Fase A 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WahaWebhookController memproses seluruh lifecycle (log, parse, insert TChat/TChatD, resolve LID, call AI dengan timeout 45 detik, kirim WAHA, broadcast) dalam satu HTTP request. Provider AI lambat memblok request, WAHA retry setelah timeout menggandakan pemrosesan; dengan 100 chat/menit worker habis. Webhook diringkas menjadi log & ack, pemrosesan berat dipindah ke queue."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_redis_cache_queue_driver", "label": "Redis sebagai Cache & Queue Driver", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 2; Problem 4; Goals Fase A 2,4,5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CACHE_STORE dan QUEUE_CONNECTION berbasis database membuat cache settings, broadcast event, dan seluruh job berkompetisi di tabel yang sama dengan transaksi chat; SQL Server punya lock mechanism lebih berat dari MySQL. Redis memisahkan beban cache/queue dari database transaksional."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_dashboard_aggregation_optimization", "label": "Optimasi Dashboard dengan SQL Aggregation", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 3; Goals Fase A 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashboard::loadDashboard() memuat SELURUH TChatD dalam range tanggal ke memory PHP lalu filter via Collection; 30 hari x 50.000 pesan x 30 user bersamaan = 1,5 juta row di RAM. Diganti agregasi SUM/COUNT/GROUP BY di SQL."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_debounced_broadcast", "label": "Debounced Broadcast", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 5; Goals Fase A 6; Risks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setiap pesan baru memicu broadcast WahaInboxUpdated; burst 20 pesan dalam 2 detik memaksa browser memanggil loadInbox() 20 kali dengan full DB query masing-masing. Debounce 300-500ms dianggap masih real-time."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_circuit_breaker_wahasender", "label": "Circuit Breaker WahaSender", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 7; Goals Fase A 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tidak ada circuit breaker di WahaSender untuk mencegah cascade failure saat WAHA down; breaker membuka setelah 5 kegagalan berturut-turut selama 2 menit."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_webhook_rate_limiting", "label": "Rate Limiting Endpoint Webhook", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 7; Goals Fase A 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoint /webhooks/waha/{token?} tanpa rate limiting; bila WAHA mengalami loop, ribuan webhook per detik bisa menghancurkan application server."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_waha_chat_helper", "label": "Shared WahaChatHelper", "file_type": "rationale", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Problem 6; Goals Fase A 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "normalizeWahaChatId() dan latestIncomingWahaChatId() terduplikasi di AiAutoReplyService, WahaWebhookProcessor, dan InboxWhatsapp; ketika format WhatsApp ID berubah harus diubah di 3 tempat dan bug di salah satunya membuat pesan tidak sampai."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_vpoint_assistant_chatbot", "label": "VPoint Assistant \u2014 Internal Chatbot", "file_type": "concept", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Fase B; Problem 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tim CS, Supervisor, dan Admin membutuhkan lookup knowledge, statistik operasional, draft balasan, dan guidance aplikasi yang saat ini harus dilakukan manual melalui UI berbeda-beda. Chatbot hanya internal admin panel, tidak untuk customer WhatsApp; history disimpan di DB lokal karena sensitivitas data."}, {"id": "openspec_changes_scalability_optimization_and_chatbot_proposal_knowledge_base_rag", "label": "Knowledge Base RAG dari MPengetahuan", "file_type": "concept", "source_file": "openspec/changes/scalability-optimization-and-chatbot/proposal.md", "source_location": "Goals Fase B 2; Risks Fase B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grounding jawaban dengan knowledge base memitigasi halusinasi AI; limit history dan limit knowledge context menekan biaya token."}], "edges": [{"source": "openspec_changes_scalability_optimization_and_chatbot_proposal_async_webhook_processing", "target": "openspec_changes_scalability_optimization_and_chatbot_specs_vpoint_care_spec_asynchronous_webhook_processing", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/scalability-optimization-